# OmniRoute Configuration
# Required secrets (auto-generated by Railway template)

# JWT signing key for dashboard session tokens
JWT_SECRET=your-jwt-secret-here

# Encryption key for API keys stored in the database
API_KEY_SECRET=your-api-key-secret-here

# Initial admin login password (change after first login)
INITIAL_PASSWORD=your-initial-password-here

# Canonical public URL of this deployment. Without these the app falls back to
# http://localhost:20128, which breaks OAuth callback and cloud-sync links in
# the dashboard. On Railway they resolve to https://${{RAILWAY_PUBLIC_DOMAIN}}.
BASE_URL=https://your-service.up.railway.app
NEXT_PUBLIC_BASE_URL=https://your-service.up.railway.app

# Bind address. Must be 0.0.0.0 for Railway to route traffic to the service.
HOSTNAME=0.0.0.0
NODE_ENV=production

# Set the Secure flag on session cookies. Upstream defaults to false.
AUTH_COOKIE_SECURE=true

# Data directory for SQLite database and storage
DATA_DIR=/app/data

# Service port
PORT=20128

# Optional: Enable SQLite encryption at rest
# STORAGE_ENCRYPTION_KEY=your-encryption-key-here

# Optional: Explicit V8 heap ceiling in MB. Leave empty to size the heap from
# the container's memory limit (60%, min 614MB). Set e.g. 2048 on a 4GB+ plan.
# OMNIROUTE_MEMORY_MB=2048

# Note: REQUIRE_API_KEY defaults to true upstream — unauthenticated /v1 requests
# are rejected unless you change it in Dashboard -> Settings -> Security.

