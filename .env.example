# OmniRoute Configuration
# Required secrets (auto-generated by Railway template)

# JWT signing key for dashboard session tokens
JWT_SECRET=your-jwt-secret-here

# Encryption key for API keys stored in the database
API_KEY_SECRET=your-api-key-secret-here

# Initial admin login password (change after first login)
INITIAL_PASSWORD=your-initial-password-here

# Data directory for SQLite database and storage
DATA_DIR=/app/data

# Service port
PORT=20128

# Optional: Enable SQLite encryption at rest
# STORAGE_ENCRYPTION_KEY=your-encryption-key-here

# Optional: Require API key for all proxy requests
# REQUIRE_API_KEY=true

# Optional: Enable secure cookies (auto-detected on Railway)
# AUTH_COOKIE_SECURE=true
